{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard \ud83e\udd16",
  "rebaseWhen": "behind-base-branch",
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Automerge only pin/pinDigest updates: they record the exact ref of an already-referenced version and introduce no new upstream code. Every other update requires a human merge.",
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "platformAutomerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on Monday"
    ]
  }
}
