    "test:gate": "node scripts/test-baseline.mjs",
    "test:gate:update": "node scripts/test-baseline.mjs --update",
    "typecheck": "vue-tsc --noEmit",
    "update:wolves-playlist": "node scripts/update-wolves-playlist.js",
    "update:back-catalogue": "node scripts/update-back-catalogue.js",
    "record:wolves": "node record-wolves.cjs",
    "generate:wolves-qrs": "node scripts/generate-qrs.js",
    "check:docs": "node scripts/check-docs.mjs",
    "check:git-hygiene": "node scripts/check-git-hygiene.mjs",
    "test:git-hygiene": "node scripts/check-git-hygiene.mjs --self-test",
    "update:image-versions": "node scripts/update-image-versions.js",
    "check:image-sboms": "node scripts/update-image-versions.js --check-only"
  },
  "dependencies": {
    "@fontsource/michroma": "^5.2.8",
    "@fontsource/share-tech-mono": "^5.2.7",
