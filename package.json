{
  "name": "project-bluefin-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-wallpapers.js && vite",
    "build": "node scripts/generate-wallpapers.js && vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
