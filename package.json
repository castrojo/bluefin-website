    "@iframe-resizer/parent": "5.5.7",
    "@iframe-resizer/vue": "5.5.7",
    "@types/js-yaml": "^4.0.9",
    "@types/marked": "^6.0.0",
    "@vueuse/components": "^14.0.0",
    "@vueuse/core": "^14.0.0",
    "js-yaml": "^4.3.1",
    "marked": "^16.0.0",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "sass": "^1.83.4",
    "vue": "^3.5.13",
    "vue-i18n": "^11.0.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.11",
    "@xmldom/xmldom": "^0.9.10",
    "eslint": "^9.38.0",
    "eslint-plugin-format": "^1.0.2",
    "happy-dom": "^20.10.6",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.2",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "^4.1.4",
    "vue-tsc": "3.1.3"
